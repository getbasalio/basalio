{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Magnetic Button",
  "description": "A button that subtly follows the pointer within its bounds. Motion is disabled for keyboard users and reduced-motion preferences.",
  "motionType": "schema-driven",
  "trigger": "Pointer / focus",
  "parameters": {
    "strength": {
      "label": "Magnetic strength",
      "type": "range",
      "token": "strength",
      "default": 18,
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "%"
    },
    "reducedMotionFallback": {
      "label": "Reduced-motion fallback",
      "type": "select",
      "token": "fallback",
      "default": "no magnetism",
      "options": [
        { "value": "no magnetism", "label": "No magnetism" }
      ]
    }
  }
}
