{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grid Reveal",
  "description": "A grid of items that reveal on hover or focus. Keyboard users see the same reveal order as pointer users.",
  "motionType": "css-only",
  "trigger": "Hover / focus",
  "parameters": {
    "revealStyle": {
      "label": "Reveal style",
      "type": "select",
      "token": "style",
      "default": "crossfade",
      "options": [
        { "value": "crossfade", "label": "Crossfade" },
        { "value": "opacity", "label": "Simple opacity" }
      ]
    },
    "reducedMotionFallback": {
      "label": "Reduced-motion fallback",
      "type": "select",
      "token": "fallback",
      "default": "appear instantly",
      "options": [
        { "value": "appear instantly", "label": "Appear instantly" }
      ]
    }
  }
}
