{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Case Study Transition",
  "description": "A click- or keyboard-triggered transition between project states. Focus is managed and announcements use a polite live region.",
  "motionType": "schema-driven",
  "trigger": "Click / keyboard",
  "parameters": {
    "transitionDuration": {
      "label": "Transition duration",
      "type": "select",
      "token": "duration",
      "default": "base",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "base", "label": "Base" },
        { "value": "long", "label": "Long" }
      ]
    },
    "easing": {
      "label": "Easing",
      "type": "select",
      "token": "easing",
      "default": "glide",
      "options": [
        { "value": "glide", "label": "Glide" },
        { "value": "snap", "label": "Snap" },
        { "value": "ease", "label": "Ease" }
      ]
    },
    "focusTarget": {
      "label": "Focus target after transition",
      "type": "select",
      "token": "focus",
      "default": "next panel",
      "options": [
        { "value": "next panel", "label": "Next panel" },
        { "value": "top", "label": "Top of block" },
        { "value": "none", "label": "No change" }
      ]
    },
    "announceChange": {
      "label": "Announce state change",
      "type": "select",
      "token": "announcement",
      "default": "polite",
      "options": [
        { "value": "polite", "label": "Polite" },
        { "value": "off", "label": "Off" }
      ]
    },
    "reducedMotionFallback": {
      "label": "Reduced-motion fallback",
      "type": "select",
      "token": "fallback",
      "default": "crossfade",
      "options": [
        { "value": "crossfade", "label": "Crossfade" }
      ]
    }
  }
}
