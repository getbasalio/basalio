{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Text Reveal",
  "description": "Staged entrance for a headline, subhead, and optional CTA. The real text is in the DOM immediately so screen readers can access it before motion runs.",
  "motionType": "css-only",
  "trigger": "Scroll into view",
  "parameters": {
    "splitUnit": {
      "label": "Split unit",
      "type": "select",
      "default": "line",
      "options": [
        { "value": "word", "label": "Word" },
        { "value": "line", "label": "Line" },
        { "value": "character", "label": "Character" }
      ]
    },
    "duration": {
      "label": "Duration",
      "type": "select",
      "token": "duration",
      "default": "base",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "base", "label": "Base" },
        { "value": "long", "label": "Long" }
      ]
    },
    "easing": {
      "label": "Easing",
      "type": "select",
      "token": "easing",
      "default": "glide",
      "options": [
        { "value": "glide", "label": "Glide" },
        { "value": "snap", "label": "Snap" },
        { "value": "ease", "label": "Ease" },
        { "value": "linear", "label": "Linear" }
      ]
    },
    "triggerThreshold": {
      "label": "Trigger threshold",
      "type": "range",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    "reducedMotionFallback": {
      "label": "Reduced-motion fallback",
      "type": "select",
      "default": "appear instantly",
      "options": [
        { "value": "appear instantly", "label": "Appear instantly" },
        { "value": "fade", "label": "Fade in" },
        { "value": "none", "label": "No motion" }
      ]
    }
  }
}
