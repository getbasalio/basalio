{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scroll Sequence",
  "description": "Scroll-driven image sequence with a single accessible image fallback and no autoplay.",
  "motionType": "schema-driven",
  "trigger": "Scroll",
  "parameters": {
    "reducedMotionFallback": {
      "label": "Reduced-motion fallback",
      "type": "select",
      "token": "fallback",
      "default": "last frame",
      "options": [
        { "value": "last frame", "label": "Show last frame" }
      ]
    }
  }
}
