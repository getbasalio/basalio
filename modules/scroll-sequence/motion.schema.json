{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scroll Sequence",
  "description": "Scroll-driven image sequence with a single accessible image fallback and no autoplay.",
  "motionType": "schema-driven",
  "trigger": "Scroll",
  "parameters": {
    "frameCount": {
      "label": "Frame count",
      "type": "range",
      "token": "count",
      "default": 24,
      "min": 6,
      "max": 120,
      "step": 1
    },
    "startFrame": {
      "label": "Start frame",
      "type": "range",
      "token": "frame",
      "default": 1,
      "min": 1,
      "max": 120,
      "step": 1
    },
    "endFrame": {
      "label": "End frame",
      "type": "range",
      "token": "frame",
      "default": 24,
      "min": 1,
      "max": 120,
      "step": 1
    },
    "scrubSmoothness": {
      "label": "Scrub smoothness",
      "type": "range",
      "token": "smoothing",
      "default": 1,
      "min": 1,
      "max": 10,
      "step": 1
    },
    "reducedMotionFallback": {
      "label": "Reduced-motion fallback",
      "type": "select",
      "token": "fallback",
      "default": "last frame",
      "options": [
        { "value": "last frame", "label": "Show last frame" },
        { "value": "first frame", "label": "Show first frame" },
        { "value": "none", "label": "No fallback" }
      ]
    }
  }
}
