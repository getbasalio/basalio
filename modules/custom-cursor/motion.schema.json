{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Custom Cursor",
  "description": "Replaces the default cursor on supported sections. Falls back to the system cursor for reduced-motion users and touch devices.",
  "motionType": "schema-driven",
  "trigger": "Pointer",
  "parameters": {
    "size": {
      "label": "Cursor size",
      "type": "range",
      "token": "size",
      "default": 30,
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    "cursorStyle": {
      "label": "Accent shape",
      "type": "select",
      "default": "ring",
      "options": [
        { "value": "ring", "label": "Ring" },
        { "value": "dot", "label": "Dot" }
      ]
    },
    "reducedMotionFallback": {
      "label": "Reduced-motion fallback",
      "type": "select",
      "token": "fallback",
      "default": "system cursor",
      "options": [
        { "value": "system cursor", "label": "System cursor" }
      ]
    }
  }
}
